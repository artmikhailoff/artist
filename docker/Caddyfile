{
	email admin@northlayertech.com
}

# Public HTTPS is published on host :8443 (container :443) because host :443 is OpenVPN stunnel.
http://{$ARTIST_DOMAIN:kasabov.northlayertech.com} {
	redir https://{$ARTIST_DOMAIN:kasabov.northlayertech.com}:8443{uri} permanent
}

https://{$ARTIST_DOMAIN:kasabov.northlayertech.com} {
	encode gzip zstd

	tls {
		issuer acme
	}

	handle {
		root * /srv
		file_server

		@static path *.css *.js *.jpg *.jpeg *.png *.gif *.ico *.svg *.webp *.mp4 *.webm *.woff *.woff2
		header @static Cache-Control "public, max-age=604800"
	}
}
